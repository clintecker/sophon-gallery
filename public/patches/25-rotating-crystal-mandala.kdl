// Counter-rotating spectral crystal planes form a seamless twelve-second mandala.
patch id="example-rotating-crystal-mandala" {
    output width=240 height=240 rate-hz=30
    node "gradient" id="midnight" label="Deep indigo field" {
        axis "radial"
        sample-a coverage-r=0.008 coverage-g=0.002 coverage-b=0.03 coverage-a=1.0 emission-r=0.01 emission-g=0.0 emission-b=0.04
        sample-b coverage-r=0.001 coverage-g=0.0 coverage-b=0.006 coverage-a=1.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
    }
    node "gradient" id="cyan-plane" label="Transparent cyan crystal plane" {
        axis "horizontal"
        sample-a coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
        sample-b coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.01 emission-g=0.32 emission-b=0.72
    }
    node "gradient" id="gold-plane" label="Transparent gold crystal plane" {
        axis "vertical"
        sample-a coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.68 emission-g=0.16 emission-b=0.01
        sample-b coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
    }
    node "transform" id="cyan-rotation" label="Clockwise crystal orbit" {
        translation-x 0.0 unit="px"
        translation-y 0.0 unit="px"
        scale-x 0.72 unit="ratio"
        scale-y 0.09 unit="ratio"
        rotation 0.0 unit="degrees"
        rotation-per-frame 12.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "nearest"
        edge "transparent"
    }
    node "mirror" id="cyan-cross" label="Crossed cyan crystal" { axis "both" }
    node "composite" id="cyan-star" label="Cyan four-point crystal"
    node "transform" id="cyan-sixty" label="Cyan crystal rotated sixty degrees" {
        translation-x 0.0 unit="px"
        translation-y 0.0 unit="px"
        scale-x 1.0 unit="ratio"
        scale-y 1.0 unit="ratio"
        rotation 60.0 unit="degrees"
        rotation-per-frame 0.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "nearest"
        edge "transparent"
    }
    node "transform" id="cyan-one-twenty" label="Cyan crystal rotated one hundred twenty degrees" {
        translation-x 0.0 unit="px"
        translation-y 0.0 unit="px"
        scale-x 1.0 unit="ratio"
        scale-y 1.0 unit="ratio"
        rotation 120.0 unit="degrees"
        rotation-per-frame 0.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "nearest"
        edge "transparent"
    }
    node "composite" id="cyan-sixfold" label="First cyan crystal crossing"
    node "composite" id="cyan-rosette" label="Sixfold cyan crystal rosette"
    node "transform" id="gold-rotation" label="Counter-clockwise crystal orbit" {
        translation-x 0.0 unit="px"
        translation-y 0.0 unit="px"
        scale-x 0.09 unit="ratio"
        scale-y 0.68 unit="ratio"
        rotation 45.0 unit="degrees"
        rotation-per-frame -6.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "nearest"
        edge "transparent"
    }
    node "mirror" id="gold-cross" label="Crossed gold crystal" { axis "both" }
    node "composite" id="gold-star" label="Gold four-point crystal"
    node "transform" id="gold-sixty" label="Gold crystal rotated sixty degrees" {
        translation-x 0.0 unit="px"
        translation-y 0.0 unit="px"
        scale-x 1.0 unit="ratio"
        scale-y 1.0 unit="ratio"
        rotation 60.0 unit="degrees"
        rotation-per-frame 0.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "nearest"
        edge "transparent"
    }
    node "transform" id="gold-one-twenty" label="Gold crystal rotated one hundred twenty degrees" {
        translation-x 0.0 unit="px"
        translation-y 0.0 unit="px"
        scale-x 1.0 unit="ratio"
        scale-y 1.0 unit="ratio"
        rotation 120.0 unit="degrees"
        rotation-per-frame 0.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "nearest"
        edge "transparent"
    }
    node "composite" id="gold-sixfold" label="First gold crystal crossing"
    node "composite" id="gold-rosette" label="Sixfold gold crystal rosette"
    node "composite" id="crystal-core" label="Counter-rotating spectral core"
    node "blur" id="spectral-halo" label="Wide crystal halo" { radius 10 unit="px" }
    node "modulate" id="crisp-crystal" label="Controlled crystal core" { amount 0.42 unit="ratio" }
    node "composite" id="bloomed-crystal" label="Halo behind crisp crystal"
    node "composite" id="program-image" label="Finished rotating crystal mandala"
    connect id="cyan-motion" from="cyan-plane.image" to="cyan-rotation.image"
    connect id="cyan-reflect" from="cyan-rotation.image" to="cyan-cross.image"
    connect id="cyan-base" from="cyan-rotation.image" to="cyan-star.background"
    connect id="cyan-opposite" from="cyan-cross.image" to="cyan-star.foreground"
    connect id="cyan-sixty-source" from="cyan-star.image" to="cyan-sixty.image"
    connect id="cyan-one-twenty-source" from="cyan-star.image" to="cyan-one-twenty.image"
    connect id="cyan-sixfold-base" from="cyan-star.image" to="cyan-sixfold.background"
    connect id="cyan-sixfold-layer" from="cyan-sixty.image" to="cyan-sixfold.foreground"
    connect id="cyan-rosette-base" from="cyan-sixfold.image" to="cyan-rosette.background"
    connect id="cyan-rosette-layer" from="cyan-one-twenty.image" to="cyan-rosette.foreground"
    connect id="gold-motion" from="gold-plane.image" to="gold-rotation.image"
    connect id="gold-reflect" from="gold-rotation.image" to="gold-cross.image"
    connect id="gold-base" from="gold-rotation.image" to="gold-star.background"
    connect id="gold-opposite" from="gold-cross.image" to="gold-star.foreground"
    connect id="gold-sixty-source" from="gold-star.image" to="gold-sixty.image"
    connect id="gold-one-twenty-source" from="gold-star.image" to="gold-one-twenty.image"
    connect id="gold-sixfold-base" from="gold-star.image" to="gold-sixfold.background"
    connect id="gold-sixfold-layer" from="gold-sixty.image" to="gold-sixfold.foreground"
    connect id="gold-rosette-base" from="gold-sixfold.image" to="gold-rosette.background"
    connect id="gold-rosette-layer" from="gold-one-twenty.image" to="gold-rosette.foreground"
    connect id="cyan-crystal" from="cyan-rosette.image" to="crystal-core.background"
    connect id="gold-crystal" from="gold-rosette.image" to="crystal-core.foreground"
    connect id="halo-source" from="crystal-core.image" to="spectral-halo.image"
    connect id="core-source" from="crystal-core.image" to="crisp-crystal.image"
    connect id="halo-layer" from="spectral-halo.image" to="bloomed-crystal.background"
    connect id="core-layer" from="crisp-crystal.image" to="bloomed-crystal.foreground"
    connect id="background" from="midnight.image" to="program-image.background"
    connect id="crystal" from="bloomed-crystal.image" to="program-image.foreground"
    sink id="program" input="program-image.image"
}
