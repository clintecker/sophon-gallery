// One moving light is reflected into a fourfold neon bloom.
patch id="example-fourfold-neon-bloom" {
    output width=180 height=90 rate-hz=30

    node "gradient" id="midnight" label="Midnight blue background" {
        axis "vertical"
        sample-a coverage-r=0.002 coverage-g=0.003 coverage-b=0.018 coverage-a=1.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
        sample-b coverage-r=0.020 coverage-g=0.002 coverage-b=0.050 coverage-a=1.0 emission-r=0.0 emission-g=0.0 emission-b=0.015
    }
    node "gradient" id="neon-seed" label="Electric cyan-magenta light" {
        axis "radial"
        sample-a coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=1.8 emission-g=0.2 emission-b=2.4
        sample-b coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
    }
    node "gradient" id="hollow-matte" label="Transparent center matte" {
        axis "radial"
        sample-a coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
        sample-b coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=1.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
    }
    node "mask" id="neon-ring" label="Hollow neon seed"
    node "scroll" id="orbit" label="Moving asymmetric light" {
        x-offset 41 unit="px"
        y-offset 17 unit="px"
        x-per-frame 6 unit="px"
        y-per-frame 3 unit="px"
    }
    node "mirror" id="opposite-side" label="Left-right reflection" {
        axis "left-right"
    }
    node "composite" id="horizontal-pair" label="Two opposing lights"
    node "mirror" id="opposite-row" label="Top-bottom reflection" {
        axis "top-bottom"
    }
    node "composite" id="fourfold-light" label="Fourfold reflected bloom"
    node "composite" id="program-image" label="Neon bloom over midnight"

    connect id="seed-image" from="neon-seed.image" to="neon-ring.image"
    connect id="seed-hollow" from="hollow-matte.image" to="neon-ring.mask"
    connect id="seed-motion" from="neon-ring.image" to="orbit.image"
    connect id="motion-mirror" from="orbit.image" to="opposite-side.image"
    connect id="pair-original" from="orbit.image" to="horizontal-pair.background"
    connect id="pair-reflection" from="opposite-side.image" to="horizontal-pair.foreground"
    connect id="pair-mirror" from="horizontal-pair.image" to="opposite-row.image"
    connect id="bloom-upper" from="horizontal-pair.image" to="fourfold-light.background"
    connect id="bloom-lower" from="opposite-row.image" to="fourfold-light.foreground"
    connect id="background" from="midnight.image" to="program-image.background"
    connect id="light" from="fourfold-light.image" to="program-image.foreground"
    sink id="program" input="program-image.image"
}
