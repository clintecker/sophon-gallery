// An asymmetric luminous sigil repeats through logarithmic depth as music bends and breathes the tunnel.
patch id="example-audio-infinite-dream-tunnel" {
    output width=1920 height=1080 rate-hz=30

    node "gradient" id="deep-field" label="Petrol-violet infinite atmosphere" {
        axis "horizontal"
        sample-a coverage-r=0.006 coverage-g=0.055 coverage-b=0.075 coverage-a=1.0 emission-r=0.0 emission-g=0.085 emission-b=0.13
        sample-b coverage-r=0.045 coverage-g=0.002 coverage-b=0.072 coverage-a=1.0 emission-r=0.075 emission-g=0.0 emission-b=0.14
    }
    node "circle" id="cyan-orbit" label="Offset cyan orbital membrane" {
        center-x 0.31 unit="ratio"
        center-y 0.40 unit="ratio"
        inner-radius 0.105 unit="ratio"
        outer-radius 0.155 unit="ratio"
        feather 3 unit="px"
        sample coverage-r=0.008 coverage-g=0.64 coverage-b=0.78 coverage-a=0.90 emission-r=0.02 emission-g=0.52 emission-b=0.72
    }
    node "tile" id="cyan-constellation" label="Mirrored cyan orbital constellation" {
        offset-x 0.0 unit="px"
        offset-y 0.0 unit="px"
        repetitions-x 4.0 unit="ratio"
        repetitions-y 3.0 unit="ratio"
        sampling "linear"
        mode "mirror"
    }
    node "circle" id="magenta-orbit" label="Offset magenta orbital membrane" {
        center-x 0.69 unit="ratio"
        center-y 0.62 unit="ratio"
        inner-radius 0.055 unit="ratio"
        outer-radius 0.115 unit="ratio"
        feather 3 unit="px"
        sample coverage-r=0.78 coverage-g=0.015 coverage-b=0.48 coverage-a=0.88 emission-r=0.66 emission-g=0.005 emission-b=0.42
    }
    node "tile" id="magenta-constellation" label="Mirrored magenta orbital constellation" {
        offset-x 0.0 unit="px"
        offset-y 0.0 unit="px"
        repetitions-x 3.0 unit="ratio"
        repetitions-y 4.0 unit="ratio"
        sampling "linear"
        mode "mirror"
    }
    node "segment" id="amber-diagonal" label="Amber transit filament" {
        start-x 0.07 unit="ratio"
        start-y 0.79 unit="ratio"
        end-x 0.92 unit="ratio"
        end-y 0.24 unit="ratio"
        radius 0.009 unit="ratio"
        feather 2 unit="px"
        sample coverage-r=0.82 coverage-g=0.29 coverage-b=0.012 coverage-a=0.84 emission-r=0.74 emission-g=0.20 emission-b=0.002
    }
    node "tile" id="amber-array" label="Mirrored amber transit array" {
        offset-x 0.0 unit="px"
        offset-y 0.0 unit="px"
        repetitions-x 3.0 unit="ratio"
        repetitions-y 3.0 unit="ratio"
        sampling "linear"
        mode "mirror"
    }
    node "segment" id="violet-diagonal" label="Counter-crossed violet filament" {
        start-x 0.18 unit="ratio"
        start-y 0.12 unit="ratio"
        end-x 0.78 unit="ratio"
        end-y 0.91 unit="ratio"
        radius 0.006 unit="ratio"
        feather 2 unit="px"
        sample coverage-r=0.34 coverage-g=0.025 coverage-b=0.72 coverage-a=0.78 emission-r=0.26 emission-g=0.01 emission-b=0.62
    }
    node "tile" id="violet-array" label="Mirrored violet transit array" {
        offset-x 0.0 unit="px"
        offset-y 0.0 unit="px"
        repetitions-x 4.0 unit="ratio"
        repetitions-y 3.0 unit="ratio"
        sampling "linear"
        mode "mirror"
    }
    node "rectangle" id="aqua-seed" label="Rounded aqua tunnel seed" {
        center-x 0.54 unit="ratio"
        center-y 0.43 unit="ratio"
        width 0.18 unit="ratio"
        height 0.065 unit="ratio"
        corner-radius 0.86 unit="ratio"
        feather 3 unit="px"
        sample coverage-r=0.01 coverage-g=0.52 coverage-b=0.50 coverage-a=0.68 emission-r=0.015 emission-g=0.30 emission-b=0.30
    }
    node "composite" id="sigil-one" label="First orbital layer"
    node "composite" id="sigil-two" label="Second orbital layer"
    node "composite" id="sigil-three" label="Amber crossed layer"
    node "composite" id="sigil-four" label="Violet crossed layer"
    node "composite" id="sigil" label="Complete asymmetric tunnel sigil"

    node "droste" id="infinite-well" label="Audio-conducted logarithmic dream tunnel" {
        center-x 0.50 unit="ratio"
        center-y 0.50 unit="ratio"
        inner-radius 0.105 unit="ratio"
        scale 2.35 unit="ratio"
        twist 92.0 unit="degrees"
        phase 0.0 unit="ratio"
        strength 1.0 unit="ratio"
        sampling "linear"
        edge "mirror"
    }
    node "hue-rotate" id="spectrum" label="Migrating tunnel spectrum" { angle 0.0 unit="degrees" }
    node "contrast" id="depth" label="Bass-carved logarithmic depth" { amount 1.0 unit="ratio" }
    node "bloom" id="atmosphere" label="Air-opened infinite atmosphere" {
        radius 14 unit="px"
        intensity 0.18 unit="ratio"
    }

    signal "audio-band" id="bass" band="low" response="decibel"
    signal "audio-band" id="low-mid" band="low-mid" response="decibel"
    signal "audio-band" id="high-mid" band="high-mid" response="decibel"
    signal "audio-band" id="air" band="high" response="decibel"
    signal "lfo" id="radial-cycle" cycles=1 seconds=17 waveform="sine" phase=0.0
    signal "lfo" id="center-x" cycles=1 seconds=23 waveform="sine" phase=0.13
    signal "lfo" id="center-y" cycles=1 seconds=29 waveform="triangle" phase=0.41
    signal "lfo" id="twist-direction" cycles=1 seconds=11 waveform="sine" phase=0.67
    signal "lfo" id="slow-spectrum" cycles=1 seconds=31 waveform="sine" phase=0.27
    signal "math" id="bass-twist" operation="multiply" left="bass" right="twist-direction"

    route id="endless-radial-cycle" from="radial-cycle" to="infinite-well" parameter="droste/phase" mode="replace" scale=0.5 offset=0.5 attack-ms=50 release-ms=260
    route id="wandering-center-x" from="center-x" to="infinite-well" parameter="droste/center-x" mode="replace" scale=0.27 offset=0.5 attack-ms=90 release-ms=520
    route id="wandering-center-y" from="center-y" to="infinite-well" parameter="droste/center-y" mode="replace" scale=0.22 offset=0.5 attack-ms=90 release-ms=520
    route id="bass-reversible-spiral" from="bass-twist" to="infinite-well" parameter="droste/twist" mode="replace" scale=330.0 offset=0.0 attack-ms=5 release-ms=300
    route id="low-mid-level-spacing" from="low-mid" to="infinite-well" parameter="droste/scale" mode="replace" curve="ease-in-out-sine" scale=3.2 offset=1.35 attack-ms=8 release-ms=360
    route id="high-mid-core-radius" from="high-mid" to="infinite-well" parameter="droste/inner-radius" mode="replace" curve="ease-out-expo" scale=0.20 offset=0.035 attack-ms=7 release-ms=340
    route id="bass-tunnel-strength" from="bass" to="infinite-well" parameter="droste/strength" mode="replace" curve="ease-out-quint" scale=0.42 offset=0.58 attack-ms=5 release-ms=320
    route id="slow-cyan-drift-x" from="center-x" to="cyan-constellation" parameter="tile/offset-x" mode="replace" scale=180.0 offset=0.0 attack-ms=100 release-ms=600
    route id="slow-cyan-drift-y" from="center-y" to="cyan-constellation" parameter="tile/offset-y" mode="replace" scale=130.0 offset=0.0 attack-ms=100 release-ms=600
    route id="slow-magenta-drift-x" from="center-y" to="magenta-constellation" parameter="tile/offset-x" mode="replace" scale=-150.0 offset=0.0 attack-ms=100 release-ms=600
    route id="slow-magenta-drift-y" from="center-x" to="magenta-constellation" parameter="tile/offset-y" mode="replace" scale=110.0 offset=0.0 attack-ms=100 release-ms=600
    route id="slow-color-migration" from="slow-spectrum" to="spectrum" parameter="hue-rotate/angle" mode="replace" scale=44.0 offset=0.0 attack-ms=100 release-ms=600
    route id="bass-depth" from="bass" to="depth" parameter="contrast/amount" mode="replace" curve="ease-out-quint" scale=1.20 offset=0.72 attack-ms=5 release-ms=300
    route id="air-bloom-radius" from="air" to="atmosphere" parameter="bloom/radius" mode="replace" curve="ease-out-expo" scale=52.0 offset=4.0 attack-ms=5 release-ms=340
    route id="air-bloom-energy" from="air" to="atmosphere" parameter="bloom/intensity" mode="replace" curve="ease-out-quint" scale=0.40 offset=0.12 attack-ms=5 release-ms=380

    connect id="field-sigil-one" from="deep-field.image" to="sigil-one.background"
    connect id="cyan-constellation-source" from="cyan-orbit.image" to="cyan-constellation.image"
    connect id="cyan-sigil-one" from="cyan-constellation.image" to="sigil-one.foreground"
    connect id="sigil-one-two" from="sigil-one.image" to="sigil-two.background"
    connect id="magenta-constellation-source" from="magenta-orbit.image" to="magenta-constellation.image"
    connect id="magenta-sigil-two" from="magenta-constellation.image" to="sigil-two.foreground"
    connect id="sigil-two-three" from="sigil-two.image" to="sigil-three.background"
    connect id="amber-array-source" from="amber-diagonal.image" to="amber-array.image"
    connect id="amber-sigil-three" from="amber-array.image" to="sigil-three.foreground"
    connect id="sigil-three-four" from="sigil-three.image" to="sigil-four.background"
    connect id="violet-array-source" from="violet-diagonal.image" to="violet-array.image"
    connect id="violet-sigil-four" from="violet-array.image" to="sigil-four.foreground"
    connect id="sigil-four-complete" from="sigil-four.image" to="sigil.background"
    connect id="seed-complete" from="aqua-seed.image" to="sigil.foreground"
    connect id="sigil-infinite" from="sigil.image" to="infinite-well.image"
    connect id="infinite-spectrum" from="infinite-well.image" to="spectrum.image"
    connect id="spectrum-depth" from="spectrum.image" to="depth.image"
    connect id="depth-atmosphere" from="depth.image" to="atmosphere.image"
    sink id="program" input="atmosphere.image"
}
