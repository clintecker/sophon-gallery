// GPU Philox stardust paints a bounded, slowly turning prismatic memory.
patch id="example-philox-nebula-memory" {
    output width=1280 height=720 rate-hz=30

    node "gradient" id="night" label="Deep ultraviolet arena" {
        axis "radial"
        sample-a coverage-r=0.012 coverage-g=0.002 coverage-b=0.040 coverage-a=1.0 emission-r=0.006 emission-g=0.0 emission-b=0.018
        sample-b coverage-r=0.001 coverage-g=0.001 coverage-b=0.006 coverage-a=1.0 emission-r=0.0 emission-g=0.0 emission-b=0.0
    }
    node "noise" id="stardust" label="Deterministic cyan and magenta stardust" {
        seed 11806310474565
        sample-a coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.0 emission-g=0.008 emission-b=0.018
        sample-b coverage-r=0.0 coverage-g=0.0 coverage-b=0.0 coverage-a=0.0 emission-r=0.62 emission-g=1.0 emission-b=1.0
    }
    node "modulate" id="fresh-level" label="Restrained fresh glitter" {
        amount 0.075 unit="ratio"
    }
    node "transform" id="memory-drift" label="Slow recursive nebula drift" {
        translation-x 1.5 unit="px"
        translation-y -0.75 unit="px"
        scale-x 0.994 unit="ratio"
        scale-y 0.994 unit="ratio"
        rotation 0.45 unit="degrees"
        rotation-per-frame 0.0 unit="degrees"
        pivot-x 0.5 unit="ratio"
        pivot-y 0.5 unit="ratio"
        sampling "linear"
        edge "mirror"
    }
    node "modulate" id="memory-decay" label="Long phosphor persistence" {
        amount 0.955 unit="ratio"
    }
    node "composite" id="memory" label="Bounded Philox nebula memory"
    node "kaleidoscope" id="prism" label="Twelvefold nebula crystal" {
        center-x 0.5 unit="ratio"
        center-y 0.5 unit="ratio"
        segments 12
        angle 0.0 unit="degrees"
        sampling "linear"
        edge "mirror"
    }
    node "bloom" id="atmosphere" label="Soft arena-scale starlight" {
        radius 8 unit="px"
        intensity 0.36 unit="ratio"
    }
    node "composite" id="lit-nebula" label="Crisp crystal over its atmosphere"
    node "composite" id="program-image" label="Nebula crystal over deep space"

    signal "lfo" id="prism-turn" cycles=1 seconds=18 waveform="sine" phase=0.0
    signal "lfo" id="halo-breath" cycles=1 seconds=9 waveform="sine" phase=0.25
    route id="turn-prism" from="prism-turn" to="prism" parameter="kaleidoscope/angle" mode="replace" scale=24.0 offset=-12.0
    route id="breathe-halo" from="halo-breath" to="atmosphere" parameter="bloom/intensity" mode="replace" scale=0.20 offset=0.24

    connect id="fresh-dust" from="stardust.image" to="fresh-level.image"
    connect id="previous-memory" from="memory.image" to="memory-drift.image" timing="previous-frame"
    connect id="drift-decay" from="memory-drift.image" to="memory-decay.image"
    connect id="memory-base" from="memory-decay.image" to="memory.background"
    connect id="inject-dust" from="fresh-level.image" to="memory.foreground"
    connect id="fold-memory" from="memory.image" to="prism.image"
    connect id="spread-light" from="prism.image" to="atmosphere.image"
    connect id="halo-base" from="atmosphere.image" to="lit-nebula.background"
    connect id="crisp-prism" from="prism.image" to="lit-nebula.foreground"
    connect id="night-base" from="night.image" to="program-image.background"
    connect id="nebula-layer" from="lit-nebula.image" to="program-image.foreground"
    sink id="program" input="program-image.image"
}
